<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Get CRUD</title>
</head> 
<style>
    table, th, td {
        border: 1px solid black;
        border-collapse: collapse;
        text-align: center;
    }
    .btn-edit {
        background-color: orange;
        border: none;
        margin-top: 5px;
        border-radius: 3px;
        cursor: pointer;
    }
    .btn-del {
        background-color: red;
        border: none;
        margin-top: 5px;
        border-radius: 3px;
        cursor: pointer;
    }
</style>
<body>
    <table style="width: 100%;">
        <tr>
            <th>Email</th>
            <th>First name</th>
            <th>Last name</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
        <% for(let i = 0; i < dataTable.length; i++) { %>
            <tr>
                <td><%= dataTable[i].email %></td>
                <td><%= dataTable[i].firstName %></td>
                <td><%= dataTable[i].lastName %></td>
                <td><%= dataTable[i].address %></td>
                <td type="button">
                    <a href="/edit-crud?id=<%= dataTable[i].id %>" class="btn-edit">Edit</a>
                    <a href="/delete-crud?id=<%= dataTable[i].id %>" class="btn-del">Delete</a>
                </td>
            </tr>
        <% } %>
    </table>
</body>
</html>